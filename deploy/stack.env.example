# Portainer stack variables.
#
# Paste these into the stack's environment editor in Portainer, which writes
# them to `stack.env` beside the compose file. The values below are the dev
# environment; production is the same list with different values.
#
# Locally, `cp stack.env.example stack.env` and fill it in — stack.env is
# gitignored because a filled-in copy holds two real credentials.

# --- identity ---------------------------------------------------------------
# Prefixes every container and Traefik router name, so two stacks on one host
# never collide. Traefik silently ignores a router whose name is already taken.
STACK_NAME=video-dev

# Placeholders. Put the real hostnames in Portainer's environment editor, not
# here — this file is committed, and stack.env (the filled-in copy) is not.
WEB_DOMAIN=dev.tv.example.com
API_DOMAIN=dev.api-tv.example.com

# --- images -----------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/blockfluit/video-streaming-claude

# The moving environment tag the build workflow pushes to. Deploying is manual
# — Portainer, Update the stack, with "Re-pull image" ticked — because only the
# image behind this tag changes, never the tag itself. See deploy/README.md.
#
# To pin or roll back, set this to a `dev-<short sha>` instead; every build
# pushes one alongside the moving tag for exactly that purpose.
IMAGE_TAG=dev

# --- storage ----------------------------------------------------------------
# Host paths, bind-mounted into the API container. Must be owned by uid 1000
# (the container runs as `node`), and must be two separate directories —
# DERIVED_PATH inside MEDIA_PATH is refused at boot, because generated output
# landing in the watched tree makes the ingest watcher trigger itself.
MEDIA_PATH=/srv/docker/streaming-platform-dev/media
DERIVED_PATH=/srv/docker/streaming-platform-dev/derived

# --- database ---------------------------------------------------------------
POSTGRES_USER=video
POSTGRES_DB=video
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# --- secrets ----------------------------------------------------------------
# Generate: openssl rand -base64 32
# Changing this invalidates every session and signs everybody out. That is the
# correct thing to do if it ever leaks, and an annoying thing to do by accident.
SESSION_SECRET=change-me

# --- optional tuning --------------------------------------------------------
# These have working defaults in the image; uncomment only to change one.
#
# TRANSCODE_PRESET=medium   # x264 preset — slower means smaller at equal quality
# TRANSCODE_CRF=25          # lower is better quality and a bigger file
#
# Set to the literal string `false` to stop this container watching MEDIA_ROOT
# for new files. Only relevant if the API is ever run as more than one replica,
# which nothing here does.
# INGEST_WATCHER_ENABLED=true
