// Data model for the video library — see docs/PLAN.md for the reasoning behind it.
//
// Three things this file cannot express, all handled elsewhere:
//   - CHECK constraints. ListItem, Credit and WatchlistItem are polymorphic and each needs
//     CHECK ((collectionId IS NULL) <> (videoId IS NULL)), hand-added to the migration.
//   - Uniqueness over nullable columns. Postgres treats NULLs as distinct, so composite
//     uniques containing one do not prevent duplicates; those are enforced in the services.
//   - Partial (filtered) unique indexes. VideoRequest allows one *open* request per
//     normalised title and any number of settled ones, which is a UNIQUE ... WHERE —
//     hand-added to the migration. It is what makes "already requested" atomic rather
//     than a check-then-write with a gap in the middle.

// The v7 generator emits TypeScript, not compiled JS, so the output has to sit under src/
// or tsc infers a different rootDir and `nest build` starts emitting dist/src/main.js.
generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated"
  moduleFormat = "cjs"
}

// The connection URL lives in prisma.config.ts (Prisma 7 moved it out of the schema).
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum TokenKind {
  BOOTSTRAP
  INVITE
}

enum PublishState {
  DRAFT
  PUBLISHED
  ARCHIVED
  MISSING
}

enum MediaOrigin {
  UPLOAD
  INGEST
  EXTRACTED
}

/// Where a piece of artwork came from, tracked per image rather than per video:
/// an admin can hand-pick a poster and still let the banner regenerate.
enum ArtworkSource {
  AUTO
  MANUAL
}

enum CreditRole {
  ACTOR
  DIRECTOR
  WRITER
  PRODUCER
  COMPOSER
  CINEMATOGRAPHER
  EDITOR
  OTHER
}

enum JobType {
  PROBE
  THUMBNAIL
  TRANSCODE
  SUBTITLE_EXTRACT
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Where a viewer's request for something the library does not have has got to.
/// NEW is where every request starts; the rest are an admin's answer.
enum RequestStatus {
  NEW
  SEEN
  PROCESSING
  NOT_AVAILABLE
  REJECTED
  AVAILABLE
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  // Login identity. Stored lowercase so uniqueness and lookups are
  // case-insensitive without needing citext or a functional index.
  username     String   @unique
  passwordHash String // argon2id
  // What actually gets rendered — seeded from the username as typed at signup,
  // so changing how your name displays never changes how you log in.
  displayName  String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploads          Video[]
  progress         WatchProgress[]
  events           WatchEvent[]
  comments         Comment[]
  watchlist        WatchlistItem[]
  jobs             MediaJob[]
  mintedBy         InviteToken[]   @relation("Minter")
  redeemedBy       InviteToken[]   @relation("Redeemer")
  requests         VideoRequest[]  @relation("Requester")
  requestsReviewed VideoRequest[]  @relation("RequestReviewer")
}

model InviteToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique // sha256(plaintext); the plaintext is shown once and never stored
  kind         TokenKind @default(INVITE)
  grantsRole   Role      @default(USER)
  expiresAt    DateTime
  redeemedAt   DateTime?
  revokedAt    DateTime?
  createdById  String?
  createdBy    User?     @relation("Minter", fields: [createdById], references: [id])
  redeemedById String?   @unique
  redeemedUser User?     @relation("Redeemer", fields: [redeemedById], references: [id])
  createdAt    DateTime  @default(now())
}

// Owned by migrations so connect-pg-simple's manual table.sql isn't needed.
model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("session")
}

// ---------------------------------------------------------------------------
// Library
// ---------------------------------------------------------------------------

model Collection {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  /// normaliseTitle(title) — the key "is this already in the library?" compares on.
  /// Deliberately not the slug: a slug is stable once created and drifts away from
  /// the title it came from, so matching on one would miss every renamed record.
  /// Written by titleData() wherever title is; '' means "not comparable" and never matches.
  normalisedTitle String    @default("")
  description String?
  year        Int?
  tags        String[]     @default([])
  /// The admin's override, not the whole answer. Null means "not overridden": the
  /// artwork then resolves to the first video's, and to the stock image for a
  /// collection holding none. A collection is a shelf, so its picture follows what
  /// is on it until somebody chooses one.
  posterKey   String?
  bannerKey   String?
  /// A collection's own trailer, independent of its episodes'. See Video.
  trailerYoutubeId String?
  /// `<drive>/<item>` for a collection ingest proposed from disk, null for one an
  /// admin made by hand. Nullable because a collection is a library idea, not a
  /// folder — Postgres treats NULLs as distinct, so any number may have none.
  folderKey   String?      @unique
  state       PublishState @default(DRAFT)
  origin      MediaOrigin  @default(INGEST)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  seasons       Season[]
  videos        CollectionVideo[]
  credits       Credit[]
  listItems     ListItem[]
  watchlistedBy WatchlistItem[]

  @@index([state])
  @@index([normalisedTitle])
}

model Season {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  number       Int? // null when the folder name didn't parse
  slug         String // "season-1", or the slugified folder name
  title        String
  description  String?
  posterKey    String?
  /// Null for a season an admin created without a folder behind it.
  folderKey    String?    @unique
  videos       CollectionVideo[]

  @@unique([collectionId, number]) // Postgres permits repeated NULLs — see the service layer
  @@unique([collectionId, slug])
  @@index([collectionId])
}

/// A video's membership of a collection.
///
/// A video is a standalone entity that may sit in several collections, or in
/// none at all, so the things that are true *of a membership* rather than of the
/// video live here: which season it is in, and where it comes in the running
/// order. The same episode can be episode 3 of a show and item 1 of a
/// best-of row without either fact overwriting the other.
///
/// `seasonId` must belong to `collectionId`. Prisma cannot express that across a
/// relation, so it is enforced in the service layer — the same arrangement as
/// the polymorphic CHECK constraints.
model CollectionVideo {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  videoId      String
  video        Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  seasonId     String?
  season       Season?    @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  /// Deliberately not unique: a unique index collides during drag-reordering,
  /// which is why a reorder rewrites the whole sequence in one transaction.
  orderIndex   Int?
  addedAt      DateTime   @default(now())

  @@unique([collectionId, videoId])
  @@index([collectionId, seasonId, orderIndex])
  @@index([videoId])
  @@index([seasonId])
}

model Video {
  id           String       @id @default(cuid())
  /// Unique library-wide, because a video is addressed on its own at /v/<slug>
  /// rather than through whichever collection you happened to arrive from.
  slug         String       @unique
  title        String
  /// normaliseTitle(title) — see the note on Collection.normalisedTitle.
  normalisedTitle String @default("")
  description  String?
  tags         String[]     @default([])
  state        PublishState @default(DRAFT)
  origin       MediaOrigin  @default(INGEST)

  storageKey   String    @unique // SOURCE file, relative to MEDIA_ROOT
  contentTag   String // partial hash, for move detection
  originalName String
  mimeType     String
  sizeBytes    BigInt
  fileMtime    DateTime
  durationSec  Float?
  width        Int?
  height       Int?
  videoCodec   String?
  audioCodec   String?
  audioTracks  Int? // surfaced so multi-audio loss is visible before converting
  probedAt     DateTime?
  probeError   String?
  missingSince DateTime?
  /// What the video was before the missing sweep, so a file that comes back is
  /// restored rather than silently demoted to DRAFT.
  stateBeforeMissing PublishState?

  // playbackKey is the converted MP4 in DERIVED_ROOT; streaming serves playbackKey ?? storageKey,
  // so the same URL keeps working before and after conversion.
  playbackKey     String?
  playbackMime    String?
  needsConversion Boolean   @default(false)
  sourceDeletedAt DateTime? // source reclaimed after conversion — exempt from the missing sweep

  /// Two shapes, both captured from the same frame 10% in and both replaceable.
  /// The banner is 16:9 (the old `thumbnailKey`, renamed for what it is); the
  /// poster is a 2:3 centre crop of the same frame. MANUAL is never clobbered by
  /// a reprobe, and the two sources move independently.
  posterKey    String?
  posterSource ArtworkSource @default(AUTO)
  bannerKey    String?
  bannerSource ArtworkSource @default(AUTO)

  /// The 11-character YouTube id, never a URL. Parsed by `parseYoutubeId` at the
  /// edge so the embed URL — privacy host, autoplay, mute — stays ours to choose
  /// rather than frozen into whatever someone pasted.
  trailerYoutubeId String?

  introStartSec Float? // all four markers are independently optional
  introEndSec   Float?
  outroStartSec Float?
  outroEndSec   Float?

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subtitles     Subtitle[]
  jobs          MediaJob[]
  issues        IngestIssue[]
  credits       Credit[]
  comments      Comment[]
  progress      WatchProgress[]
  events        WatchEvent[]
  listItems     ListItem[]
  watchlistedBy WatchlistItem[]
  collections   CollectionVideo[]

  @@index([state])
  @@index([contentTag])
  @@index([normalisedTitle])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

model MediaJob {
  id          String    @id @default(cuid())
  videoId     String
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  type        JobType
  status      JobStatus @default(QUEUED)
  progress    Float     @default(0) // 0..1, parsed from ffmpeg -progress
  etaSeconds  Int?
  message     String?
  error       String?
  /**
   * The tail of ffmpeg's own stderr, so an admin can see what it is actually
   * doing rather than only a bar. Bounded in the writer — a long encode emits
   * megabytes and none of the middle is worth keeping.
   */
  logTail     String?
  outputKey   String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([videoId])
}

// ---------------------------------------------------------------------------
// Subtitles
// ---------------------------------------------------------------------------

model Subtitle {
  id           String      @id @default(cuid())
  videoId      String
  video        Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  language     String // lowercase ISO code, "en"
  label        String // "English (SDH)"
  storageKey   String      @unique // the .vtt actually served
  sourceKey    String? // original .srt/.ass, if converted
  sourceFormat String // vtt | srt | ass
  isDefault    Boolean     @default(false)
  origin       MediaOrigin @default(INGEST)
  createdAt    DateTime    @default(now())

  @@unique([videoId, language, label])
  @@index([videoId])
}

// ---------------------------------------------------------------------------
// People and credits
// ---------------------------------------------------------------------------

model Person {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  bio       String?
  photoKey  String?
  credits   Credit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Credit {
  id            String      @id @default(cuid())
  personId      String
  person        Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  role          CreditRole
  characterName String? // for ACTOR
  position      Int         @default(0) // billing order
  collectionId  String?
  collection    Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  videoId       String?
  video         Video?      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([videoId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Comments
// ---------------------------------------------------------------------------

model Comment {
  id           String    @id @default(cuid())
  videoId      String
  video        Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body         String
  timestampSec Float? // optional pin to a playback position
  editedAt     DateTime?
  deletedAt    DateTime? // soft delete keeps thread context and an audit trail
  deletedById  String?
  createdAt    DateTime  @default(now())

  @@index([videoId, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

/// Someone asking for something the library does not have.
///
/// The row holds who asked; the API's serializer is what decides whether a given
/// caller is allowed to know. Other viewers see the title, year, comment and
/// status and never the name — an admin sees all of it. That asymmetry is the
/// whole feature, so it lives in one pure function with its own tests rather
/// than in whichever query happens to be running.
///
/// `normalisedTitle` carries a **partial unique index**, added by hand in the
/// migration because Prisma cannot express one:
///
///     CREATE UNIQUE INDEX ... ON "VideoRequest" ("normalisedTitle")
///       WHERE "status" IN ('NEW', 'SEEN', 'PROCESSING');
///
/// One open request per title, any number of settled ones. Asking again for
/// something rejected a year ago is a fair question; asking twice for what is
/// already being processed is a duplicate, and the index is what makes catching
/// it atomic rather than a check-then-write with a gap in the middle.
model VideoRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)

  title           String
  /// normaliseTitle(title) — what both duplicate checks compare on.
  normalisedTitle String
  year            Int?
  /// The requester's own note. Shown to everyone, so it is content, not metadata.
  comment         String?

  status    RequestStatus @default(NEW)
  /// The admin's answer in words. REJECTED on its own tells nobody why.
  adminNote String?

  /// Who last answered, and when. Null while the request is still untouched —
  /// `createdAt` already says when it arrived.
  statusChangedAt   DateTime?
  statusChangedById String?
  statusChangedBy   User?     @relation("RequestReviewer", fields: [statusChangedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([normalisedTitle])
}

// ---------------------------------------------------------------------------
// My List
// ---------------------------------------------------------------------------

model WatchlistItem {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  videoId      String?
  video        Video?      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([userId, collectionId]) // makes "add" idempotent — a double-click can't duplicate
  @@unique([userId, videoId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Curated rows
// ---------------------------------------------------------------------------

/// Where a row's contents come from.
///
/// MANUAL is the original curated row: an admin picks entries one at a time and
/// they are stored as ListItems. Everything else is computed per request from a
/// rule, so the shelf keeps up with the library without anyone maintaining it.
///
/// CONTINUE_WATCHING and MY_LIST are per-*user* — the row is the same idea for
/// everyone but resolves to different entries per caller. They were hardcoded
/// blocks on the home page before this; making them rows is what lets an admin
/// reorder or hide them alongside everything else.
enum RowSource {
  MANUAL
  RECENTLY_ADDED
  TRENDING // watched most inside a rolling window
  MOST_VIEWED // all-time view count
  CONTINUE_WATCHING
  MY_LIST
}

/// What a row's cards are.
///
/// AUTO is what browse.vue already shows: collections *and* standalone videos,
/// ranked together in one shelf. A film in this model is a video belonging to no
/// collection, so that pairing is exactly "shows roll up, films stay films" —
/// an episode's score counts towards every collection it is in, and a video with
/// no collection stands as itself rather than vanishing.
///
/// COLLECTIONS drops standalone videos; VIDEOS ranks videos individually and
/// rolls nothing up, which is the "recently added episodes" shelf.
enum RowKind {
  AUTO
  COLLECTIONS
  VIDEOS
}

model CuratedList {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String?
  position    Int        @default(0) // row order on the home page
  isVisible   Boolean    @default(true)
  items       ListItem[]

  source RowSource @default(MANUAL)
  kind   RowKind   @default(AUTO)
  /// How many cards a computed row resolves to. Ignored by MANUAL, whose
  /// contents are chosen rather than ranked and are bounded by
  /// MAX_ITEMS_PER_LIST instead.
  maxItems   Int       @default(20)
  /// The rolling window TRENDING ranks over, in days. Null on every other
  /// source — nothing else has a window, and storing a number nobody reads is
  /// how a field ends up meaning two things.
  windowDays Int?
  /// Narrows the pool a computed row ranks over. Empty means no filter.
  tags       String[]  @default([])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  /// Prisma cannot express the partial unique that stops a second personal row:
  ///
  ///     CREATE UNIQUE INDEX "CuratedList_personal_source_key"
  ///       ON "CuratedList"("source")
  ///       WHERE "source" IN ('CONTINUE_WATCHING', 'MY_LIST');
  ///
  /// Re-append it if this migration is ever regenerated, like the polymorphic
  /// CHECKs and VideoRequest's open-request index. Two Continue Watching
  /// shelves is not a configuration anyone wants, it is a double-click.
  @@index([position])
}

model ListItem {
  id           String      @id @default(cuid())
  listId       String
  list         CuratedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  position     Int // deliberately not unique — a unique index collides mid drag-reorder
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  videoId      String?
  video        Video?      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([listId, collectionId])
  @@unique([listId, videoId])
  @@index([listId, position])
}

// ---------------------------------------------------------------------------
// Watch tracking
// ---------------------------------------------------------------------------

// One rollup row per (user, video) — powers resume + continue-watching.
model WatchProgress {
  id              String   @id @default(cuid())
  userId          String
  videoId         String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  lastPositionSec Float    @default(0)
  maxPositionSec  Float    @default(0)
  secondsWatched  Float    @default(0)
  viewCount       Int      @default(0)
  completed       Boolean  @default(false)
  firstWatchedAt  DateTime @default(now())
  lastWatchedAt   DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([videoId])
  @@index([userId, lastWatchedAt])
}

model WatchEvent {
  id            String   @id @default(cuid())
  userId        String
  videoId       String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  playSessionId String // uuid per page-load
  positionSec   Float
  deltaSec      Float
  createdAt     DateTime @default(now())

  @@index([videoId, createdAt])
  @@index([playSessionId])
  /// Trending scans a date range across every video at once. The composite
  /// above leads on videoId, so it cannot serve that scan — this one can.
  @@index([createdAt])
}

/// Structural problems found during ingest — recorded rather than silently dropped.
///
/// Keyed on (kind, path) and upserted, so rescanning does not pile up duplicates
/// of the same complaint. An issue that stops appearing is resolved rather than
/// deleted, which keeps a record of what the library used to be unhappy about.
enum IngestIssueKind {
  ROOT_LEVEL_FILE // a video sitting directly in MEDIA_ROOT
  LOOSE_DRIVE_FILE // a video loose in a drive root, with no folder to take a shape from
  PATH_TOO_DEEP // nested below drive/item/season/file
  UNREADABLE_SEASON // a season folder whose number could not be parsed
  ORPHAN_SUBTITLE // a sidecar matching no video
  AMBIGUOUS_SUBTITLE // a sidecar matching several videos equally well
  UNREADABLE_FILE // on disk but unreadable — permissions, or a bad mount
  MISSING_FILE // a row whose file has gone
}

model IngestIssue {
  id     String          @id @default(cuid())
  kind   IngestIssueKind
  /// Relative to MEDIA_ROOT. The natural identity of an issue together with kind.
  path   String
  detail String?

  /// Set when the issue is about a row that already exists.
  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  /// Non-null once a scan no longer finds the problem.
  resolvedAt  DateTime?

  @@unique([kind, path])
  @@index([resolvedAt])
  @@index([videoId])
}
