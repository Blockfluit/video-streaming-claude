{
  "extends": "./tsconfig.json",
  // prisma.config.ts is CLI-time config, not application code. Leaving it in the
  // build program drags the inferred rootDir up to apps/api, which silently moves
  // the entrypoint to dist/src/main.js and breaks `npm start`.
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma.config.ts"]
}
