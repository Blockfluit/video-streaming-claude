# Copy to apps/api/.env and adjust. `.env` is gitignored — never commit real secrets.

# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://video:video@localhost:5432/video?schema=public"

# Any long random string: `openssl rand -base64 32`
SESSION_SECRET="change-me"

NODE_ENV=development
PORT=4000

# Resolved relative to apps/api (the cwd of the API process).
# MEDIA_ROOT is the watched source tree; DERIVED_ROOT holds generated output and
# must never live inside MEDIA_ROOT, or the watcher fires on the app's own writes.
MEDIA_ROOT="../../media"
DERIVED_ROOT="../../derived"

# 2 GB
MAX_UPLOAD_BYTES=2147483648

INGEST_WATCHER_ENABLED=true

TRANSCODE_CONCURRENCY=1
TRANSCODE_PRESET=medium
TRANSCODE_CRF=25

# Where the one-time master token is written when no admin account exists yet.
# Relative paths resolve from apps/api, as MEDIA_ROOT does. The file is a live
# credential: mode 600, and deleted as soon as it is redeemed.
# BOOTSTRAP_TOKEN_FILE="../../.bootstrap-token"

# Leave unset to use the system binaries on PATH.
# FFMPEG_PATH=
# FFPROBE_PATH=

# Importing title metadata from TMDB (themoviedb.org).
#
# Unset, the feature is simply off: the admin screens hide the "Find metadata"
# button and every /admin/metadata route answers 503 saying so. Nothing else in
# the app changes, and no request ever leaves the machine.
#
# This is an "API Read Access Token" from a TMDB account under Settings > API —
# the long JWT-looking one, not the short v3 key. It is sent as a bearer token.
# TMDB_API_TOKEN=

# Which language TMDB answers in.
# TMDB_LANGUAGE=en-US

# Whose age ratings to import. A film is certified per country and per release,
# so this picks which one lands in `certification` — "US" gives PG-13/R, "NL"
# gives the Kijkwijzer ages, "GB" gives the BBFC ones. US is the most
# consistently populated, which is why it is the default rather than the best.
# TMDB_CERTIFICATION_COUNTRY=US

# The width imported artwork is fetched at. TMDB serves fixed sizes; w780 is
# comfortably above what any card or hero renders at.
# TMDB_IMAGE_SIZE=w780

# ---- Subtitle search (OpenSubtitles) ----------------------------------------
# Unset, the feature is off: the video editor hides its "Find subtitles" button
# and both subtitle-search routes answer 503 saying so. Nothing else changes,
# and no request leaves the machine.
#
# Searching sends a title, or a hash of the source file, to opensubtitles.com.
# That is the whole reason this is opt-in on a private library rather than on by
# default, and why nothing fetches subtitles on its own.
#
# The key is from an opensubtitles.com account under Consumers > New Consumer.
# OPENSUBTITLES_API_KEY=

# Downloading — not searching — also needs the account itself, and the free tier
# allows only a handful of downloads a day.
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=

# How this server identifies itself. OpenSubtitles refuses a client that does
# not, so there is a default; override it if you have registered a name.
# OPENSUBTITLES_USER_AGENT=video-streaming-claude v1.0
