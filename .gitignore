# Dependencies
node_modules/
.pnp
.pnp.js

# Secrets — never commit
.env
.env.*
!.env.example
.bootstrap-token

# Media library and generated assets (can be very large).
# The directories themselves are tracked so a fresh clone has the roots the
# API expects; their contents never are.
media/*
!media/.gitkeep
derived/*
!derived/.gitkeep

# Build output
dist/
build/
.nuxt/
.output/
.nitro/
.cache/
*.tsbuildinfo

# Prisma generated client — emitted as TypeScript, so it lives under src/
apps/api/src/prisma/generated/

# Logs
*.log
npm-debug.log*
logs/

# Test / coverage
coverage/
.nyc_output/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Playwright run artifacts — a per-run file that changes on every invocation.
test-results/
playwright-report/
