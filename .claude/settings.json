{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm test:*)",
      "Bash(npm view:*)",
      "Bash(npx prisma:*)",
      "Bash(npx nest:*)",
      "Bash(npx nuxi:*)",
      "Bash(node --version)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(ffprobe:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(curl -i:*)",
      "Bash(curl -s:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(docker compose down -v:*)",
      "Read(./.env)",
      "Read(./.bootstrap-token)"
    ]
  }
}
